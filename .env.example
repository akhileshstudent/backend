# Activate with SPRING_PROFILES_ACTIVE=prod. Spring Boot does not load this file automatically.
JWT_SECRET=replace-with-at-least-32-random-characters
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your-neon-username
SPRING_DATASOURCE_PASSWORD=replace-with-your-neon-password
CORS_ORIGINS=https://your-frontend.example
