# Activate with SPRING_PROFILES_ACTIVE=prod. Spring Boot does not load this file automatically.
JWT_SECRET=replace-with-at-least-32-random-characters
SPRING_DATASOURCE_URL=jdbc:postgresql://your-render-postgres-host:5432/your-database
SPRING_DATASOURCE_USERNAME=your-database-user
SPRING_DATASOURCE_PASSWORD=replace-with-your-database-password
CORS_ORIGINS=https://your-frontend.example
